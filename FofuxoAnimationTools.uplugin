{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "0.1.0",
	"FriendlyName": "Fofuxo's Animation Tools",
	"Description": "Animation tools for Unreal. Exports Animation Sequences and a Skeletal Mesh into a single file, each animation as a named take. In the IK Retargeter, it adds preview attachments stored in the retargeter itself, pose editing with the animation running, a pose that travels between projects, a second viewport locked to the source bone, and bone selection by proximity.",
	"Category": "Animation",
	"CreatedBy": "Antonio Froz",
	"CanContainContent": false,
	"IsBetaVersion": true,
	"Installed": false,
	"Modules": [
