			"Name": "FofuxoExporter",
			"Type": "Editor",
			"LoadingPhase": "PostEngineInit"
		},
		{
			"Name": "FofuxoRetargetOps",
			"Type": "Runtime",
			"LoadingPhase": "Default"
		},
		{
